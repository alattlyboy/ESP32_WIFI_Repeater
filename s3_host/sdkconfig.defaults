# ESP32-S3 主机侧默认配置
# 用法：idf.py set-target esp32s3 之前把这些值放在项目根的 sdkconfig.defaults

# ---- Flash / 分区 ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- NAT 必需的三件套 ----
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# ---- Wi-Fi Remote（远端射频在 C5 上）----
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# ---- ESP-Hosted 传输层：SPI 全双工 ----
CONFIG_ESP_HOSTED_HOST_TYPE_MCU=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y

# 引脚（S3 侧）—— 与 C5 侧接线一一对应，可在 menuconfig 里改
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=12
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=11
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=13
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=10
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=17
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=4
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=42

# SPI 时钟：默认 10MHz —— 这是 1.0 在 10cm 杜邦线上验证稳定的值，出厂固件就用它。
# 想让隧道再快一点可以改 20（甚至 40），但必须先确认走线质量：
#   1) 线长 ≤ 10cm，GND 至少 2 根，时钟线两侧夹地
#   2) 改完跑 10 分钟 iperf3 + 持续 ping，丢包率必须为 0
#   3) 一旦出现随机丢包 / ping 抖动，立刻改回 10
# 判定标准和实测数据见 docs/操作手册.md §7。
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=10

# ---- 其它 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- 企业版 802.1X（校园网）----
# 主机侧的 EAP 包装层；不开的话 esp_eap_client_remote_* 会落到弱符号桩，
# 调用直接返回 ESP_ERR_NOT_SUPPORTED（0x105）。C5 侧还要开 CP_FEAT_WIFI_EXT_ENT。
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ENT=y
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=y

# ---- 吞吐优化（2.2）----
# 默认 TCP 窗口只有 5760B（4 个 MSS），RTT 20ms 时单流上限约 2.3Mbps，
# 多流还会互相挤占；调到 64K 后上限 >20Mbps。
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# 10MHz 下 SPI 隧道聚合只有 ~1Mbps，40MHz 才能跑满 2.4G 热点。
# 若换长排线后出现 "spi transfer failed"，退回 20 或 10。
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=40
